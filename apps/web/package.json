{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names css,web \"bun x @tailwindcss/cli -i src/styles.css -o src/compiled.css --watch\" \"ng serve\"",
    "build:css": "bun x @tailwindcss/cli -i src/styles.css -o src/compiled.css --minify",
    "build": "bun run build:css && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "oxlint",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.19",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "oxlint": "^1.74.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2"
  }
}
